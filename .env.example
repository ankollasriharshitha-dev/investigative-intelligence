# Investigative Intelligence Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Active Data Provider: 'synthetic', 'uploaded', or 'postgres'
DATA_PROVIDER=postgres

# PostgreSQL Connection URL
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:2006@localhost:5432/investigative_intelligence

# Demo Password for initial seeded accounts (optional override)
II_DEMO_PASSWORD=DemoPass!2026
